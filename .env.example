# Copy to .env (gitignored) for restricted-network environments; compose
# auto-loads .env and forwards these as build args to the nginx image build.
# All values are optional: an empty value means "no proxy", so plain
# environments need no .env at all.
#
# The proxy address must be reachable FROM the build containers:
#   - docker bridge network: the host gateway, e.g. http://172.17.0.1:<port>
#     (works only if the proxy listens on 0.0.0.0, not just 127.0.0.1)
#   - Docker Desktop: http://host.docker.internal:<port>
#   - direct `docker build` (without compose): pass the same values as
#     --build-arg, they are predefined and never land in the image config
#
# Diagnosing: on the host, `curl --noproxy '*' https://nginx.org/` tests
# direct egress; from a container, curl via the gateway proxy address
# tests the path docker builds will actually use.

HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.0/8,*.local
